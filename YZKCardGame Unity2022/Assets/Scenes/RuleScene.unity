--- !u!114 &623917323
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 623917321}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 50
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u521D\u59CB\u9636\u6BB5\uFF1A\n\u6BCF\u4E2A\u4EBA\u62E5\u670912\u5F20\u5361\u724C\uFF0C\u5206\u522B\u662F1~10\u661F\u7684\u666E\u901A\u724C\u4E0E\u4E24\u5F20\u70B8\u5F39\u724C\r\n\u6BCF\u5F20\u724C\u5747\u6709\u653B\u51FB\u548C\u8840\u91CF\u4E24\u4E2A\u5C5E\u6027\uFF0C\u653B\u51FB\u548C\u751F\u547D\u5747\u4E0D\u5C0F\u4E8E1\u3002\u666E\u901A\u724C\u7684\u653B\u51FB+\u751F\u547D=\u661F\u6570*2\uFF0C\u70B8\u5F39\u724C\u751F\u547D1\u653B\u51FB\u65E0\u7A77\u3002\n\r\n\u5E03\u5C40\u9636\u6BB5\uFF1A\n\u6E38\u620F\u8FDB\u884C\u5728\u4E00\u4E2A10*10(\u4E09\u4EBA\u6216\u56DB\u4EBA\u6E38\u73A9\u65F6\u4F1A\u6269\u5927\u521D\u59CB\u5927\u5C0F)\u7684\u5730\u56FE\u4E0A\uFF0C\u6BCF\u4E2A\u4EBA\u5360\u636E\u89D2\u843D\u76844*4\u5927\u5C0F\uFF0C\u5361\u724C\u53EF\u4EE5\u4EFB\u610F\u653E\u7F6E\u5728\u81EA\u5DF1\u7684\u533A\u57DF\u683C\u5B50\u4E0A\r\u3002\n\u5361\u724C\u653E\u7F6E\u597D\u4EE5\u540E\u53EA\u6709\u81EA\u5DF1\u77E5\u9053\u54EA\u5F20\u724C\u7684\u5C5E\u6027\uFF0C\u5176\u4ED6\u4EBA\u5747\u4E0D\u53EF\u89C1\u3002\n\r\n\u6E38\u620F\u5F00\u59CB\uFF1A\n\u968F\u673A\u9009\u5B9A\u4E00\u540D\u73A9\u5BB6\u5F00\u59CB\uFF0C\u6BCF\u56DE\u5408\u73A9\u5BB6\u6BCF\u6B21\u53EF\u4EE5\u9009\u62E9\u4E00\u5F20\u5361\u724C\u79FB\u52A8\u4E00\u683C\u6216\u8005\u9009\u62E9\u9644\u8FD1\u4E0A\u4E0B\u5DE6\u53F3\u7684\u5176\u4ED6\u73A9\u5BB6\u8FDB\u884C\u653B\u51FB\u3002\u56DE\u5408\u7ED3\u675F\u540E\u6309\u7167\u987A\u65F6\u9488\u6216\u8005\u9006\u65F6\u9488\u987A\u5E8F\u8BA9\u4E0B\u4E00\u540D\u73A9\u5BB6\u56DE\u5408\u5F00\u59CB\u3002\r\n\r\n\u8FDB\u653B\u89C4\u5219\uFF1A\n\u653B\u51FB\u65F6\u573A\u4E0A\u6240\u6709\u73A9\u5BB6\u5747\u53EF\u770B\u5230\u8FDB\u653B\u5361\u724C\u4E0E\u88AB\u8FDB\u653B\u5361\u724C\u7684\uFF0C\u53CC\u65B9\u540C\u65F6\u635F\u5931\u5BF9\u65B9\u653B\u51FB\u529B\u7684\u751F\u547D\u503C\u3002\u82E5\u751F\u547D\u503C\u22640\uFF0C\u5361\u724C\u88AB\u51FB\u6740\u79BB\u5F00\u573A\u5730\u3002\u82E5\u8FDB\u653B\u65B9\u6210\u529F\u51FB\u6740\u53EF\u4EE5\u9009\u62E9\u79FB\u52A8\u81F3\u88AB\u8FDB\u653B\u65B9\u7684\u4F4D\u7F6E\u3002\r\n\r\n\u7279\u6B8A\u89C4\u5219\uFF1A\n\u5730\u56FE\u7684\u8FB9\u7F18\u884C\u6216\u8005\u8FB9\u7F18\u5217\u4E00\u5B9A\u662F\u8981\u5B58\u5728\u5361\u724C\u7684\uFF0C\u82E5\u6700\u8FB9\u7F18\u7684\u4E00\u884C\u6216\u8005\u4E00\u5217\u6CA1\u6709\u5361\u724C\uFF0C\u90A3\u4E48\u8FD9\u4E00\u884C/\u5217\u5C06\u65E0\u6CD5\u518D\u6B21\u8FDB\u5165\u3002"
